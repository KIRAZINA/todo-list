# Copy this to .env and fill in a real secret before running docker compose up.
# Must be a Base64-encoded value that decodes to at least 256 bits (32 bytes),
# since the backend uses HS256.
#
# Generate one with:  openssl rand -base64 32
JWT_SECRET=replace-this-with-a-real-generated-secret

# OPTIONAL: bootstrap the very first ADMIN account on startup. Set these once,
# then remove them (the admin account persists in the DB). Leave unset to skip.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=some-strong-password
# ADMIN_EMAIL=admin@example.com